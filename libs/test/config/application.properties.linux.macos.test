# This is config is for testing purposes only!

spring.servlet.multipart.max-file-size = 4GB
spring.servlet.multipart.max-request-size = 4GB
spring.main.allow-bean-definition-overriding=true

# Root path
app.path=/tmp/salmon/test/ws

# Primary user, you can add more users with AuthUsers.addUser()
app.username=user
app.password=password
# permission: READ, WRITE, READ_WRITE
app.role=READ_WRITE

# port for testing only
server.port=8081

# CORS
# allow browser to use the web service from specific site:
app.cors.allowed-origins=http://localhost